include README.md LICENSE THIRD-PARTY-NOTICES.md dependencies.lock.json
recursive-include docs *.md
recursive-include models *.json *LICENSE
recursive-include src *.py
recursive-include tests *.py
recursive-include tools *.py *.cjs
prune _local
prune .venv
prune .venv-mlx
global-exclude __pycache__ *.py[cod] *.blp *.BLP *.mpq *.MPQ *.exe *.dll *.pth *.safetensors *.png *.npz *.npy *.log
